{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainzen.example/schemas/guidebook.schema.json",
  "title": "DomainZen Guidebook",
  "description": "A versioned set of explicit shortcut-to-URL mappings.",
  "type": "object",
  "required": ["schema_version", "name", "domains"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "description": { "type": "string", "maxLength": 500 },
    "domains": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["name", "destination"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$" },
          "destination": { "type": "string", "format": "uri", "pattern": "^https://" },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$" }
          }
        }
      }
    }
  }
}
